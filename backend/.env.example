# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MQTT (EMQX)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=athlete-guardian

# AI service (FastAPI)
AI_API_URL=http://127.0.0.1:8000/predict
AI_API_TIMEOUT_MS=20000

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Auth (login)
# Ganti dengan string acak yang panjang & rahasia, JANGAN dipakai di produksi
# apa adanya. Contoh membuat nilai acak: `openssl rand -hex 32`
JWT_SECRET=ganti-dengan-string-rahasia-yang-panjang-dan-acak
JWT_EXPIRES_IN=30d
